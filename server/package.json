    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.0",
    "shared": "workspace:*",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
