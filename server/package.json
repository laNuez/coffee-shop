{
  "name": "server",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch run src/index.ts && tsc --watch",
    "test": "bun test src",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:test:generate": "bun --env-file=.env.test drizzle-kit generate --config=drizzle-test.config.ts",
    "db:test:migrate": "bun --env-file=.env.test drizzle-kit migrate --config=drizzle-test.config.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.15.10",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.0",
    "shared": "workspace:*",
    "stripe": "^22.4.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
}
